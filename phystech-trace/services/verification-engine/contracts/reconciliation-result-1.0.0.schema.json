{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phystech-trace.local/contracts/reconciliation-result-1.0.0.schema.json",
  "title": "Phystech Trace Reconciliation Result 1.0.0 (provisional)",
  "description": "Provisional, versioned handoff contract. Values are supplied by Reconciliation and are never recomputed by Verification.",
  "type": "object",
  "additionalProperties": true,
  "required": ["contract_version", "run_metadata", "targets"],
  "properties": {
    "contract_version": {"const": "1.0.0"},
    "run_metadata": {"$ref": "#/$defs/runMetadata"},
    "targets": {"type": "array", "items": {"$ref": "#/$defs/targetResult"}}
  },
  "$defs": {
    "period": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {"start": {"type": "string"}, "end": {"type": "string"}}
    },
    "runMetadata": {
      "type": "object",
      "additionalProperties": true,
      "required": ["run_id", "project_id", "calculation_id", "generated_at", "input_data", "reconciliation_engine_version"],
      "properties": {
        "run_id": {"type": "string", "minLength": 1},
        "project_id": {"type": "string", "minLength": 1},
        "calculation_id": {"type": "string", "minLength": 1},
        "generated_at": {"type": "string", "format": "date-time"},
        "input_data": {
          "type": "object",
          "additionalProperties": true,
          "required": ["extraction_id", "extraction_schema_version", "extraction_hash", "linking_run_id"],
          "properties": {
            "extraction_id": {"type": "string", "minLength": 1},
            "extraction_schema_version": {"type": "string", "minLength": 1},
            "extraction_hash": {"type": ["string", "null"]},
            "linking_run_id": {"type": ["string", "null"]},
            "linking_contract_version": {"type": ["string", "null"]},
            "supporting_extraction_hashes": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        },
        "reconciliation_engine_version": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_document_id", "extraction_id", "json_pointer", "semantic_key", "value_type", "period", "unit", "currency", "vat_basis", "comparison_basis"],
      "properties": {
        "source_document_id": {"type": "string", "minLength": 1},
        "extraction_id": {"type": "string", "minLength": 1},
        "row_id": {"type": ["string", "null"]},
        "json_pointer": {"type": "string", "pattern": "^/"},
        "semantic_key": {"type": "string", "minLength": 1},
        "label": {"type": ["string", "null"]},
        "value_type": {"enum": ["money", "decimal", "quantity", "integer", "period", "date", "string", "boolean"]},
        "period": {"$ref": "#/$defs/period"},
        "unit": {"type": ["string", "null"]},
        "currency": {"type": ["string", "null"]},
        "vat_basis": {"enum": ["gross", "net", "not_applicable", "unknown"]},
        "comparison_basis": {"enum": ["actual", "plan", "contract", "other", "unknown"]}
      }
    },
    "sourceReference": {
      "type": "object",
      "additionalProperties": true,
      "required": ["source_id", "document_id", "extraction_id", "row_id", "json_pointer", "evidence_status"],
      "properties": {
        "source_id": {"type": "string", "minLength": 1},
        "document_id": {"type": "string", "minLength": 1},
        "extraction_id": {"type": "string", "minLength": 1},
        "row_id": {"type": ["string", "null"]},
        "json_pointer": {"type": ["string", "null"], "pattern": "^/"},
        "link_id": {"type": ["string", "null"]},
        "evidence_index": {"type": ["integer", "null"], "minimum": 0},
        "evidence_status": {"enum": ["human_confirmed", "system_validated", "unconfirmed", "rejected", "unknown"]},
        "operation_ids": {"type": "array", "items": {"type": "string"}},
        "reason": {"type": ["string", "null"]}
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": true,
      "required": ["code", "message", "confirmed", "evidence_references"],
      "properties": {
        "code": {"enum": ["duplicate_confirmed", "duplicate_suspected", "missing_document", "wrong_period", "conflicting_documents", "incomplete_sources", "invalid_unit", "rounding_rule_unknown", "other"]},
        "message": {"type": "string"},
        "confirmed": {"type": "boolean"},
        "document_ids": {"type": "array", "items": {"type": "string"}},
        "source_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_references": {"type": "array", "items": {"type": "string"}}
      }
    },
    "targetResult": {
      "type": "object",
      "additionalProperties": true,
      "required": ["target_id", "target", "result"],
      "properties": {
        "target_id": {"type": "string", "minLength": 1},
        "target": {"$ref": "#/$defs/target"},
        "result": {
          "type": "object",
          "additionalProperties": true,
          "required": ["expected_value", "value_type", "semantic_key", "period", "unit", "currency", "vat_basis", "comparison_basis", "calculation_status", "comparison_eligible", "formula", "applied_rules", "used_sources", "excluded_sources", "operations", "diagnostics", "warnings", "provenance"],
          "properties": {
            "expected_value": {"type": ["string", "number", "integer", "boolean", "object", "array", "null"]},
            "value_type": {"enum": ["money", "decimal", "quantity", "integer", "period", "date", "string", "boolean"]},
            "semantic_key": {"type": "string", "minLength": 1},
            "period": {"$ref": "#/$defs/period"},
            "unit": {"type": ["string", "null"]},
            "currency": {"type": ["string", "null"]},
            "vat_basis": {"enum": ["gross", "net", "not_applicable", "unknown"]},
            "comparison_basis": {"enum": ["actual", "plan", "contract", "other", "unknown"]},
            "calculation_status": {"enum": ["complete", "incomplete", "invalid", "not_applicable"]},
            "comparison_eligible": {"type": "boolean"},
            "formula": {"type": ["string", "null"]},
            "applied_rules": {"type": "array", "items": {"type": "string"}},
            "used_sources": {"type": "array", "items": {"$ref": "#/$defs/sourceReference"}},
            "excluded_sources": {"type": "array", "items": {"$ref": "#/$defs/sourceReference"}},
            "operations": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": true,
                "required": ["operation_id", "operation_type", "formula", "input_source_ids", "output_value"],
                "properties": {
                  "operation_id": {"type": "string"},
                  "operation_type": {"type": "string"},
                  "formula": {"type": "string"},
                  "input_source_ids": {"type": "array", "items": {"type": "string"}},
                  "output_value": {"type": ["string", "number", "integer", "object", "array", "null"]},
                  "rounding_rule": {"type": ["string", "null"]}
                }
              }
            },
            "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
            "warnings": {
              "type": "array",
              "items": {"type": "object", "required": ["code", "message"], "properties": {"code": {"type": "string"}, "message": {"type": "string"}, "severity": {"enum": ["info", "warning", "error"]}}, "additionalProperties": true}
            },
            "provenance": {"type": "array", "items": {"type": "object", "additionalProperties": true}}
          }
        }
      }
    }
  }
}
