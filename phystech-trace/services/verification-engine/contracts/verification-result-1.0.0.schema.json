{
  "$defs": {
    "Difference": {
      "properties": {
        "absolute": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Absolute"
        },
        "relative": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Relative"
        },
        "formula": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Formula"
        },
        "evaluated_actual": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated Actual"
        },
        "evaluated_expected": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Evaluated Expected"
        },
        "accepted_by": {
          "default": "none",
          "enum": [
            "exact",
            "absolute_tolerance",
            "relative_tolerance",
            "rounding",
            "none"
          ],
          "title": "Accepted By",
          "type": "string"
        }
      },
      "title": "Difference",
      "type": "object"
    },
    "Discrepancy": {
      "properties": {
        "category": {
          "$ref": "#/$defs/DiscrepancyCategory"
        },
        "established": {
          "title": "Established",
          "type": "boolean"
        },
        "hypothesis": {
          "default": false,
          "title": "Hypothesis",
          "type": "boolean"
        },
        "description": {
          "title": "Description",
          "type": "string"
        },
        "evidence_references": {
          "items": {
            "type": "string"
          },
          "title": "Evidence References",
          "type": "array"
        }
      },
      "required": [
        "category",
        "established",
        "description"
      ],
      "title": "Discrepancy",
      "type": "object"
    },
    "DiscrepancyCategory": {
      "enum": [
        "amount_difference",
        "wrong_period",
        "duplicate_operation",
        "missing_supporting_document",
        "incorrect_document_link",
        "quantity_or_indicator_difference",
        "incompatible_unit",
        "rounding_problem",
        "conflicting_primary_documents",
        "unsubstantiated_cause",
        "economic_meaning_mismatch"
      ],
      "title": "DiscrepancyCategory",
      "type": "string"
    },
    "EvidenceTrace": {
      "properties": {
        "actual_reference": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Actual Reference"
        },
        "reconciliation_reference": {
          "anyOf": [
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reconciliation Reference"
        },
        "used_sources": {
          "items": {
            "type": "object"
          },
          "title": "Used Sources",
          "type": "array"
        },
        "excluded_sources": {
          "items": {
            "type": "object"
          },
          "title": "Excluded Sources",
          "type": "array"
        },
        "linking_references": {
          "items": {
            "type": "object"
          },
          "title": "Linking References",
          "type": "array"
        },
        "provenance_chain": {
          "items": {
            "type": "object"
          },
          "title": "Provenance Chain",
          "type": "array"
        }
      },
      "title": "EvidenceTrace",
      "type": "object"
    },
    "IndicatorResult": {
      "properties": {
        "target_id": {
          "title": "Target Id",
          "type": "string"
        },
        "semantic_key": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Semantic Key"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "value_type": {
          "title": "Value Type",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/VerificationStatus"
        },
        "actual": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
