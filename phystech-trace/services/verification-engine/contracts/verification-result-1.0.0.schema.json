  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "verification_id": {
      "title": "Verification Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "calculation_id": {
      "title": "Calculation Id",
      "type": "string"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    },
    "input_fingerprint": {
      "title": "Input Fingerprint",
      "type": "string"
    },
    "input_metadata": {
      "title": "Input Metadata",
      "type": "object"
    },
    "overall_status": {
      "$ref": "#/$defs/VerificationStatus"
    },
    "summary": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Summary",
      "type": "object"
    },
    "indicators": {
      "items": {
        "$ref": "#/$defs/IndicatorResult"
      },
      "title": "Indicators",
      "type": "array"
    },
    "diagnostics": {
      "items": {
        "type": "object"
      },
      "title": "Diagnostics",
      "type": "array"
    }
  },
  "required": [
    "verification_id",
    "project_id",
    "calculation_id",
    "created_at",
    "input_fingerprint",
    "input_metadata",
    "overall_status",
    "summary",
    "indicators"
  ],
  "title": "Phystech Trace Verification Result 1.0.0",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phystech-trace.local/contracts/verification-result-1.0.0.schema.json"
}
