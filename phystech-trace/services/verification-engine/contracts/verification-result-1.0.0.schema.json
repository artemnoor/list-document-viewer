        "expected": {
          "anyOf": [
            {
              "$ref": "#/$defs/ValueEvidence"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "difference": {
          "$ref": "#/$defs/Difference"
        },
        "discrepancies": {
          "items": {
            "$ref": "#/$defs/Discrepancy"
          },
          "title": "Discrepancies",
          "type": "array"
        },
        "evidence": {
          "$ref": "#/$defs/EvidenceTrace"
        },
        "comparison_rules": {
          "title": "Comparison Rules",
          "type": "object"
        },
        "diagnostics": {
          "items": {
            "type": "object"
          },
          "title": "Diagnostics",
          "type": "array"
        },
        "uncertainty": {
          "$ref": "#/$defs/Uncertainty"
        }
      },
      "required": [
        "target_id",
        "value_type",
        "status",
        "uncertainty"
      ],
      "title": "IndicatorResult",
      "type": "object"
    },
    "PeriodRange": {
      "additionalProperties": false,
      "properties": {
        "start": {
          "title": "Start",
          "type": "string"
        },
        "end": {
          "title": "End",
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ],
      "title": "PeriodRange",
      "type": "object"
    },
    "Uncertainty": {
      "properties": {
        "level": {
          "enum": [
            "none",
            "low",
            "medium",
            "high"
          ],
          "title": "Level",
          "type": "string"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        },
        "manual_review_required": {
          "title": "Manual Review Required",
          "type": "boolean"
        },
        "status_reason": {
          "title": "Status Reason",
          "type": "string"
        }
      },
      "required": [
        "level",
        "manual_review_required",
        "status_reason"
      ],
      "title": "Uncertainty",
      "type": "object"
    },
    "ValueEvidence": {
      "properties": {
        "source_value": {
          "default": null,
          "title": "Source Value"
        },
        "normalized_value": {
          "default": null,
          "title": "Normalized Value"
        },
        "value_type": {
          "title": "Value Type",
          "type": "string"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Currency"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "period": {
          "anyOf": [
            {
              "$ref": "#/$defs/PeriodRange"
            },
            {
              "type": "null"
            }
          ],
          "default": null
