{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document Linking evaluation annotations",
  "type": "object",
  "required": ["version", "annotations_complete", "reviewer_ids", "scenarios"],
  "properties": {
    "version": { "type": "string" },
    "instructions": { "type": "string" },
    "review_mode": { "enum": ["single_reviewer", "independent_adjudication"] },
    "annotations_complete": { "type": "boolean" },
    "reviewer_ids": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "gold_links"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "source_bundle_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "source_documents": { "type": "array", "items": { "$ref": "#/$defs/sourceDocument" } },
          "predictions_file": { "type": "string" },
          "predictions_files": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "reviewed_document_pairs": { "type": "array", "items": { "$ref": "#/$defs/pairReview" } },
          "adjudicated_document_pairs": { "type": "array", "items": { "$ref": "#/$defs/pairReview" } },
          "gold_links": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["relationship_type", "source_document_id", "target_document_id", "evidence"],
              "properties": {
                "relationship_type": { "type": "string", "minLength": 1 },
                "source_document_id": { "type": "string", "minLength": 1 },
                "target_document_id": { "type": "string", "minLength": 1 },
                "source_row_id": { "type": ["string", "null"] },
                "target_row_id": { "type": ["string", "null"] },
                "evidence": { "type": "array", "items": { "$ref": "#/$defs/goldEvidence" } },
                "row_correspondences": { "type": "array", "items": { "$ref": "#/$defs/rowCorrespondence" } },
                "contradicting_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
                "ambiguity_notes": { "type": "string" }
              }
            }
          }
        },
        "allOf": [
          {
            "if": { "required": ["reviewed_document_pairs"] },
            "then": { "required": ["source_bundle_sha256", "source_documents"] }
          },
          {
            "if": { "required": ["adjudicated_document_pairs"] },
            "then": { "required": ["source_bundle_sha256", "source_documents"] }
          }
        ]
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "review_mode": { "const": "single_reviewer" } },
        "required": ["review_mode"]
      },
      "then": {
        "properties": {
          "reviewer_ids": { "minItems": 1, "maxItems": 1 },
          "scenarios": { "items": { "required": ["reviewed_document_pairs"] } }
        }
      }
    },
    {
      "if": {
        "properties": { "review_mode": { "const": "independent_adjudication" } },
        "required": ["review_mode"]
      },
      "then": {
        "properties": {
          "reviewer_ids": { "minItems": 3 },
          "scenarios": { "items": { "required": ["adjudicated_document_pairs"] } }
        }
      }
    },
    {
      "if": { "not": { "required": ["review_mode"] } },
      "then": {
        "properties": {
          "scenarios": {
            "items": {
              "anyOf": [
                { "required": ["predictions_file"] },
                { "required": ["predictions_files"] }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "sourceDocument": {
      "type": "object",
      "required": ["path", "sha256", "document_id"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "document_id": { "type": "string", "minLength": 1 },
        "extraction_id": { "type": "string" },
        "schema_version": { "type": "string" }
      }
    },
    "reference": {
      "type": "object",
      "required": ["document_id", "path", "raw_value"],
      "properties": {
        "document_id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "raw_value": {}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["source", "target", "explanation"],
      "properties": {
        "source": { "$ref": "#/$defs/reference" },
        "target": { "$ref": "#/$defs/reference" },
        "explanation": { "type": "string", "minLength": 1 }
      }
    },
    "goldEvidence": {
      "type": "object",
      "required": ["source", "target"],
      "properties": {
        "source": { "$ref": "#/$defs/reference" },
        "target": { "$ref": "#/$defs/reference" }
      }
    },
    "rowCorrespondence": {
      "type": "object",
      "required": ["decision", "supporting_evidence", "contradicting_evidence", "ambiguity_notes"],
      "properties": {
        "decision": { "enum": ["supported", "not_supported", "ambiguous"] },
        "source_row_id": { "type": "string" },
        "target_row_id": { "type": "string" },
        "supporting_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "contradicting_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "ambiguity_notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "supported" } }, "required": ["decision"] },
          "then": {
            "required": ["source_row_id", "target_row_id"],
            "properties": { "supporting_evidence": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "decision": { "const": "ambiguous" } }, "required": ["decision"] },
          "then": { "properties": { "ambiguity_notes": { "minLength": 1 } } }
        }
      ]
    },
    "relationshipInstance": {
      "type": "object",
      "required": ["decision", "relationship_type", "source_document_id", "target_document_id", "supporting_evidence", "contradicting_evidence", "row_correspondences", "ambiguity_notes"],
      "properties": {
        "decision": { "enum": ["supported", "ambiguous"] },
        "relationship_type": { "type": "string", "minLength": 1 },
        "source_document_id": { "type": "string", "minLength": 1 },
        "target_document_id": { "type": "string", "minLength": 1 },
        "source_row_id": { "type": "string" },
        "target_row_id": { "type": "string" },
        "supporting_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "contradicting_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "row_correspondences": { "type": "array", "items": { "$ref": "#/$defs/rowCorrespondence" } },
        "ambiguity_notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "supported" } }, "required": ["decision"] },
          "then": {
            "properties": { "supporting_evidence": { "minItems": 1 } }
          }
        },
        {
          "if": { "properties": { "decision": { "const": "ambiguous" } }, "required": ["decision"] },
          "then": { "properties": { "ambiguity_notes": { "minLength": 1 } } }
        }
      ]
    },
    "pairReview": {
      "type": "object",
      "required": ["left_document_id", "right_document_id", "decision", "relationship_instances", "contradicting_evidence", "ambiguity_notes"],
      "properties": {
        "left_document_id": { "type": "string", "minLength": 1 },
        "right_document_id": { "type": "string", "minLength": 1 },
        "decision": { "enum": ["supported", "not_supported", "ambiguous"] },
        "relationship_instances": { "type": "array", "items": { "$ref": "#/$defs/relationshipInstance" } },
        "contradicting_evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
        "ambiguity_notes": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "decision": { "const": "not_supported" } }, "required": ["decision"] },
          "then": { "properties": { "relationship_instances": { "maxItems": 0 } } }
        },
        {
          "if": { "properties": { "decision": { "const": "ambiguous" } }, "required": ["decision"] },
          "then": { "properties": { "ambiguity_notes": { "minLength": 1 } } }
        }
      ]
    }
  }
}
