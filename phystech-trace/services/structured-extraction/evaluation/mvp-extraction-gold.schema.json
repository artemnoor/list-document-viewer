{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://phystech-trace.local/schemas/mvp-extraction-gold-v1.json",
  "title": "Phystech Trace MVP Extraction Gold",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "review_mode", "reviewer_id", "artifacts", "scenarios"],
  "properties": {
    "schema_version": { "const": "mvp-extraction-gold-v1" },
    "review_mode": { "const": "single_reviewer" },
    "reviewer_id": { "type": "string", "minLength": 1 },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["artifact_id", "document_id", "path", "sha256", "input_hash"],
        "properties": {
          "artifact_id": { "type": "string", "minLength": 1 },
          "document_id": { "type": "string", "minLength": 1 },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "$ref": "#/$defs/sha256" },
          "input_hash": { "$ref": "#/$defs/sha256" }
        }
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["scenario_id", "source_artifact_id", "document_type", "llm_assisted_required", "fields", "expected_row_ids"],
        "properties": {
          "scenario_id": { "type": "string", "minLength": 1 },
          "source_artifact_id": { "type": "string", "minLength": 1 },
          "document_type": { "enum": ["kfz_report", "contract", "act", "invoice", "addendum", "registry", "unknown"] },
          "llm_assisted_required": { "const": true },
          "fields": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["field_key", "critical", "expected_value", "expected_raw_value", "source_path", "expected_provenance"],
              "properties": {
                "field_key": { "type": "string", "minLength": 1 },
                "critical": { "type": "boolean" },
                "expected_value": {},
                "expected_raw_value": { "type": "string", "minLength": 1 },
                "source_path": { "type": "string", "minLength": 1 },
                "expected_provenance": {
                  "type": "object",
                  "minProperties": 2,
                  "required": ["document_id", "source_text"],
                  "properties": {
                    "document_id": { "type": "string", "minLength": 1 },
                    "source_part_id": { "type": "string" },
                    "source_ref": { "type": "string" },
                    "page_no": { "type": ["number", "null"] },
                    "sheet_name": { "type": ["string", "null"] },
                    "cell_address": { "type": ["string", "null"] },
                    "table_id": { "type": "string" },
                    "row_id": { "type": "string" },
                    "column_index": { "type": "number" },
                    "source_text": { "type": "string" }
                  },
                  "additionalProperties": false,
                  "anyOf": [{ "required": ["source_ref"] }, { "required": ["source_part_id"] }]
                }
              }
            }
          },
          "expected_row_ids": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true }
        }
      }
    }
  },
  "$defs": {
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
