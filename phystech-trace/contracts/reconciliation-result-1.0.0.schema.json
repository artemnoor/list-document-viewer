{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:phystech-trace:reconciliation-result:1.0.0",
  "title": "Phystech Trace Reconciliation Result 1.0.0",
  "description": "Stable API boundary between Reconciliation Engine and downstream consumers such as Verification Engine.",
  "type": "object",
  "required": [
    "reconciliation_id",
    "contract_version",
    "engine_version",
    "created_at",
    "input_snapshot",
    "calculations",
    "diagnostics",
    "scope"
  ],
  "properties": {
    "reconciliation_id": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
    "contract_version": { "const": "1.0.0" },
    "engine_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "input_snapshot": { "$ref": "#/$defs/inputSnapshot" },
    "calculations": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/calculation" }
    },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "scope": {
      "type": "object",
      "required": ["comparison_performed", "reliability_conclusion"],
      "properties": {
        "comparison_performed": { "const": false },
        "reliability_conclusion": { "type": "null" }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "inputSnapshot": {
      "type": "object",
      "required": ["snapshot_sha256", "extraction_results", "linking_run_id", "linking_contract_version", "linking_sha256", "fact_count"],
      "properties": {
        "snapshot_sha256": { "$ref": "#/$defs/sha256" },
        "extraction_results": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["document_id", "extraction_id", "version", "schema_version", "sha256"],
            "properties": {
              "document_id": { "type": "string", "minLength": 1 },
              "extraction_id": { "type": "string", "minLength": 1 },
              "version": { "type": "number", "minimum": 0 },
              "schema_version": { "type": "string", "minLength": 1 },
              "sha256": { "$ref": "#/$defs/sha256" }
            },
            "additionalProperties": false
          }
        },
        "linking_run_id": { "type": "string", "minLength": 1 },
        "linking_contract_version": { "type": "string", "minLength": 1 },
        "linking_sha256": { "$ref": "#/$defs/sha256" },
        "fact_count": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "targetIndicator": {
      "type": "object",
      "description": "Stable target ID plus exact Extraction JSON Pointer identifying the KФЗ indicator wrapper.",
      "required": ["target_id", "label", "description", "unit", "currency", "amount_basis", "period_basis", "kfz_origin"],
      "properties": {
        "target_id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "unit": { "type": ["string", "null"] },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "amount_basis": { "enum": ["gross", "net", "unspecified"] },
        "economic_measure": { "enum": ["planned", "actual", "accrued", "paid", "unspecified"] },
        "period_basis": { "enum": ["document_period", "operation_date", "none"] },
        "kfz_origin": {
          "type": "object",
          "required": ["document_id", "extraction_id", "fact_id", "row_id", "source_path", "source_ref"],
          "properties": {
            "document_id": { "type": "string", "minLength": 1 },
            "extraction_id": { "type": ["string", "null"], "minLength": 1 },
            "fact_id": { "type": ["string", "null"], "minLength": 1 },
            "row_id": { "type": ["string", "null"] },
            "source_path": { "type": "string", "pattern": "^#/" },
            "source_ref": { "type": ["string", "null"] }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "period": {
      "type": "object",
      "required": ["start", "end", "basis"],
      "properties": {
        "start": { "type": ["string", "null"], "format": "date" },
        "end": { "type": ["string", "null"], "format": "date" },
        "basis": { "enum": ["explicit", "document_period", "operation_date", "none"] }
      },
      "additionalProperties": false
    },
    "rounding": {
      "type": "object",
      "required": ["mode", "scale", "applied"],
      "properties": {
        "mode": { "const": "ROUND_HALF_UP" },
        "scale": { "type": "integer", "minimum": 0, "maximum": 8 },
        "applied": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "required": ["fact_id", "document_id", "extraction_id", "source_path", "status", "provenance", "input_hash"],
      "properties": {
        "fact_id": { "type": "string", "minLength": 1 },
        "document_id": { "type": "string", "minLength": 1 },
        "extraction_id": { "type": "string", "minLength": 1 },
        "document_type": { "type": "string" },
        "row_id": { "type": ["string", "null"] },
        "source_path": { "type": "string", "pattern": "^#/" },
        "role": { "type": "string" },
        "key": { "type": "string" },
        "label": { "type": "string" },
        "value": {},
        "numeric_value": { "type": ["string", "null"], "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
        "source_value": {},
        "status": { "type": "string" },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "currency": { "type": ["string", "null"] },
        "unit": { "type": ["string", "null"] },
        "economic_measure": { "type": ["string", "null"], "enum": ["planned", "actual", "accrued", "paid", null] },
        "provenance": { "type": ["object", "null"] },
        "input_hash": { "$ref": "#/$defs/sha256" },
        "related_links": { "type": "array" },
        "inclusion_reason": { "type": ["string", "null"] },
        "exclusion_reason": { "type": ["string", "null"] },
        "used_in_result": { "type": ["boolean", "null"] },
        "human_confirmation": { "type": ["object", "null"] }
      },
      "additionalProperties": true
    },
    "diagnostic": {
      "type": "object",
      "required": ["severity", "code", "path", "message"],
      "properties": {
        "severity": { "enum": ["error", "warning"] },
        "code": { "type": "string", "minLength": 1 },
        "path": { "type": "string" },
        "message": { "type": "string" },
        "details": { "type": "object" }
      },
      "additionalProperties": false
    },
    "calculation": {
      "type": "object",
      "required": [
        "target", "status", "completeness_status", "uncertainty_status", "expected_value", "exact_value_before_rounding",
        "currency", "unit", "period", "amount_basis", "rounding", "sign_convention", "formula", "formula_status",
        "used_sources", "excluded_sources", "errors", "provenance", "information_gaps", "assumptions", "manual_review_required",
        "comparison_performed", "reliability_conclusion"
      ],
      "properties": {
        "target": { "$ref": "#/$defs/targetIndicator" },
        "status": { "enum": ["calculated", "insufficient_data", "manual_review"] },
        "completeness_status": { "enum": ["complete", "partial", "unknown"] },
        "uncertainty_status": { "enum": ["none", "present", "unknown"] },
        "expected_value": { "type": ["string", "null"], "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
        "exact_value_before_rounding": { "type": ["string", "null"], "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
        "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$" },
        "unit": { "type": ["string", "null"] },
        "period": { "$ref": "#/$defs/period" },
        "amount_basis": { "enum": ["gross", "net", "unspecified"] },
        "rounding": { "$ref": "#/$defs/rounding" },
        "sign_convention": { "const": "preserve_source_sign; subtraction_is_explicit" },
        "formula": { "type": ["string", "null"] },
        "formula_status": { "enum": ["executed", "proposed", "not_available"] },
        "used_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "excluded_sources": { "type": "array", "items": { "$ref": "#/$defs/source" } },
        "errors": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
        "provenance": {
          "type": "object",
          "required": ["input_snapshot_sha256", "target_indicator", "used_fact_ids", "excluded_fact_ids"],
          "properties": {
            "input_snapshot_sha256": { "$ref": "#/$defs/sha256" },
            "target_indicator": { "$ref": "#/$defs/targetIndicator/properties/kfz_origin" },
            "used_fact_ids": { "type": "array", "items": { "type": "string" } },
            "excluded_fact_ids": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "information_gaps": { "type": "array", "items": { "type": "string" } },
        "assumptions": { "type": "array", "items": { "type": "string" } },
        "manual_review_required": { "type": "boolean" },
        "comparison_performed": { "const": false },
        "reliability_conclusion": { "type": "null" }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "calculated" } }, "required": ["status"] },
          "then": {
            "properties": {
              "completeness_status": { "const": "complete" },
              "uncertainty_status": { "const": "none" },
              "expected_value": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
              "exact_value_before_rounding": { "type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?$" },
              "formula": { "type": "string", "minLength": 1 },
              "formula_status": { "const": "executed" },
              "rounding": { "properties": { "applied": { "const": true } } },
              "manual_review_required": { "const": false },
              "errors": { "maxItems": 0 },
              "information_gaps": { "maxItems": 0 },
              "assumptions": { "maxItems": 0 }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "insufficient_data" } }, "required": ["status"] },
          "then": {
            "properties": {
              "completeness_status": { "const": "unknown" },
              "uncertainty_status": { "const": "unknown" },
              "expected_value": { "type": "null" },
              "exact_value_before_rounding": { "type": "null" },
              "formula_status": { "const": "not_available" },
              "rounding": { "properties": { "applied": { "const": false } } },
              "manual_review_required": { "const": true }
            }
          }
        },
        {
          "if": { "properties": { "status": { "const": "manual_review" } }, "required": ["status"] },
          "then": {
            "properties": {
              "completeness_status": { "enum": ["partial", "unknown"] },
              "uncertainty_status": { "const": "present" },
              "expected_value": { "type": "null" },
              "exact_value_before_rounding": { "type": "null" },
              "formula_status": { "enum": ["proposed", "not_available"] },
              "rounding": { "properties": { "applied": { "const": false } } },
              "manual_review_required": { "const": true }
            }
          }
        }
      ],
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
