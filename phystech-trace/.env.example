# Use unique strong values before exposing the services beyond localhost.
POSTGRES_PASSWORD=trace_db_dev_pass_2026_7f4a2c91b6
API_BEARER_TOKEN=trace_api_local_token_2026_do_not_expose

# Optional. Linking and LLM-assisted Extraction remain unavailable without this.
# External model calls are blocked unless a project is marked public, synthetic,
# or anonymized and its owner explicitly enables the per-project consent switch.
POLZA_API_KEY=
# On Windows, POLZA_AI_API_KEY is also detected directly from the environment.

# Keep false to disable LLM calls even when the Polza key is configured.
LLM_ENABLED=true
# Allow for slower live model responses; override for local latency/cost limits.
LLM_TIMEOUT_MS=120000
# The standalone Linking service accepts up to 230000 estimated input tokens.
LLM_MAX_INPUT_TOKENS=230000
