# Local Compose binds the service to 127.0.0.1 and defaults to development mode.
# For deployment, set VERIFICATION_AUTH_MODE=required and configure one token per project.
VERIFICATION_AUTH_MODE=development
VERIFICATION_PROJECT_TOKENS={}
VERIFICATION_PORT=8000
VERIFICATION_MAX_REQUEST_BYTES=2097152
VERIFICATION_REQUEST_TIMEOUT_SECONDS=30
VERIFICATION_MAX_PROCESSING_SECONDS=30

# Optional. The deterministic verifier works when these are unset or disabled.
POLZA_AI_ENABLED=false
POLZA_AI_API_KEY=
POLZA_AI_MODEL=google/gemma-4-26b-a4b-it
POLZA_AI_BASE_URL=https://polza.ai/api/v1
POLZA_AI_TIMEOUT_SECONDS=10
