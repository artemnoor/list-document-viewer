SERVICE_NAME=Phystech Trace — Reconciliation Engine
RESULT_STORE_DIR=./data/results

# OpenAI-compatible planner endpoint. Leave LLM_ENABLED=false for local-only use.
LLM_ENABLED=false
LLM_TRUSTED_LOCAL=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CANDIDATES=300

# External endpoints require context.data_classification=open/anonymized plus
# context.external_llm_allowed=true. Set LLM_TRUSTED_LOCAL=true only for a locally
# controlled model endpoint approved to process confidential data.
