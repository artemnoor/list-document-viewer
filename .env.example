SERVICE_NAME=Phystech Trace — Reconciliation Engine
RESULT_STORE_DIR=./data/results

# OpenAI-compatible planner endpoint. Leave LLM_ENABLED=false for local-only use.
LLM_ENABLED=false
LLM_TRUSTED_LOCAL=false
LLM_BASE_URL=https://api.openai.com/v1
LLM_TRUSTED_HOSTS=[]
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=45
LLM_MAX_CANDIDATES=300

# Set ENVIRONMENT=production to require API_AUTH_ENABLED and per-project tokens.
ENVIRONMENT=local
API_AUTH_ENABLED=false
API_PROJECT_TOKENS={}

# External endpoints require context.data_classification=open/anonymized plus
# context.external_llm_allowed=true. Confidential inputs require LLM_TRUSTED_LOCAL=true
# and a loopback/private address or exact host in LLM_TRUSTED_HOSTS (JSON array).
# API_PROJECT_TOKENS is a JSON object mapping bearer tokens to project IDs.
