VERIFICATION_DB_PATH=data/verification.sqlite3
# Optional: when present, review suggestions use Polza.ai Gemma 4 26B A4B.
# Docker Compose also reads POLZA_AI_API_KEY directly from the Windows environment.
POLZA_AI_ENABLED=true
POLZA_AI_API_KEY=
POLZA_AI_MODEL=google/gemma-4-26b-a4b-it
POLZA_AI_BASE_URL=https://polza.ai/api/v1
